import sys

numbers = []

for line in sys.stdin:
    for n in line.split():
        try:
            numbers.append(float(n))
        except ValueError:
            print("数字以外は入力できません。", file=sys.stderr)
            sys.exit(1)

if len(numbers) == 0:
    print("数字を入力してください。", file=sys.stderr)
    sys.exit(1)

print("count:", len(numbers))
print("min:", min(numbers))
print("max:", max(numbers))
print("average:", sum(numbers) / len(numbers))

